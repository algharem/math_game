# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
*.bak
*.orig
*.tmp

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Local-only material kept out of the repository: source textbooks (large
# PDFs), generated docs/coverage, extracted question banks and prompt notes.
/source_pdfs/
/docs/
/coverage/
/question_bank/
/prompts/

# Local archives and scratch bundles
lib.tar.xz
*.tar.xz
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Built app packages (never commit installers)
*.apk
*.aab
*.ipa

# Agent/tooling state kept on this machine only
.agents/
skills-lock.json
.opencode/
.claude/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing (keep secrets local)
/android/key.properties
/android/app/upload-keystore.jks
/android/app/*.keystore
/android/app/*.jks

# Local environment files
.env
.env.*

# Firebase config contains the API key; keep it local (use the Firebase
# console / CI secrets to provision it on build machines).
**/google-services.json
